+// Korean TrueType HUD font, baked once at load from a .ttf via stb_truetype (no external deps,
+// same header copy the menu uses). Glyphs: ASCII + the 2350 KS X 1001 Hangul syllables.
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "../../3rdparty/mainui/font/stb_truetype.h"
+#include "../../3rdparty/mainui/font/KsxTable.h"
+
 le_struct_begin( charinfo_swap )
 	le_struct_field( charinfo, startoffset )
 	le_struct_field( charinfo, charwidth )
@@ -84,6 +91,336 @@ void CL_SetFontColor( cl_font_t *font, const rgba_t color )
 	ref.dllFuncs.Color4ub( color[0], color[1], color[2], color[3] );
 }
 
+#define TTF_FONT_NAME "gfx/fonts/tahoma.ttf" // Korean font shipped in the game data
+#define TTF_ATLAS_W 2048
+#define TTF_ATLAS_H 1024
+#define TTF_ATLAS_BORDER 1
+#define TTF_OUTLINE 1
+
+typedef struct
+{
+	wrect_t rc;
+	int advance;     // baked advance, pixels
+	int xoff, yoff;  // bitmap box offset from pen position / baseline, pixels
+} ttf_glyph_t;
+
+struct cl_ttfont_s
+{
+	stbtt_fontinfo info;
+	byte *file;
+	int pixelHeight;
+	float scale;
+	int ascent;
+	ttf_glyph_t ascii[128];
+	ttf_glyph_t hangul[sizeof( table_ksx1001 ) / sizeof( table_ksx1001[0] )];
+	int16_t ksxMap[0xD7A4 - 0xAC00]; // codepoint-0xAC00 -> hangul index+1, 0 = not present
+	int atlasX, atlasY, rowH;
+	byte *atlas;
+	int hAtlasTex;
+	char texname[32];
+};
+
+static poolhandle_t CL_TTFPool( void )
+{
+	static poolhandle_t pool = 0;
+
+	if( !pool )
+		pool = Mem_AllocPool( "TT Font Pool" );
+
+	return pool;
+}
+
+static void CL_TTFFreeFont( cl_font_t *font )
+{
+	if( font->ttf )
+	{
+		if( font->ttf->hAtlasTex )
+			ref.dllFuncs.GL_FreeTexture( font->ttf->hAtlasTex );
+		if( font->ttf->atlas )
+			Mem_Free( font->ttf->atlas );
+		if( font->ttf->file )
+			Mem_Free( font->ttf->file );
+		Mem_Free( font->ttf );
+		font->ttf = NULL;
+	}
+}
+
+static ttf_glyph_t *CL_TTFLookup( cl_ttfont_t *f, int codepoint )
+{
+	if( codepoint < 128 )
+		return &f->ascii[codepoint];
+
+	if( codepoint >= 0xAC00 && codepoint < 0xD7A4 )
+	{
+		int16_t idx = f->ksxMap[codepoint - 0xAC00];
+
+		if( idx )
+			return &f->hangul[idx - 1];
+	}
+
+	return &f->ascii['?'];
+}
+
+static void CL_TTFBakeGlyph( cl_font_t *font, int codepoint, ttf_glyph_t *glyph )
+{
+	cl_ttfont_t *f = font->ttf;
+	int gw, gh, x0, y0, x1, y1, advance, lsb;
+	byte *bitmap = NULL;
+	int w, h, px, py;
+	byte *cov;
+
+	stbtt_GetCodepointHMetrics( &f->info, codepoint, &advance, &lsb );
+	stbtt_GetCodepointBitmapBox( &f->info, codepoint, f->scale, f->scale, &x0, &y0, &x1, &y1 );
+	gw = x1 - x0;
+	gh = y1 - y0;
+
+	w = gw + ( TTF_OUTLINE * 2 ) + ( TTF_ATLAS_BORDER * 2 );
+	h = gh + ( TTF_OUTLINE * 2 ) + ( TTF_ATLAS_BORDER * 2 );
+
+	if( w > TTF_ATLAS_W || f->atlasY + h > TTF_ATLAS_H )
+	{
+		glyph->rc.left = glyph->rc.right = 0; // atlas full: draw nothing
+		glyph->rc.top = glyph->rc.bottom = 0;
+		glyph->advance = Q_rint( advance * f->scale );
+		glyph->xoff = glyph->yoff = 0;
+		return;
+	}
+
+	if( f->atlasX + w > TTF_ATLAS_W )
+	{
+		f->atlasX = 0;
+		f->atlasY += f->rowH + TTF_ATLAS_BORDER;
+		f->rowH = 0;
+
+		// ran out of atlas rows: leave the glyph unbaked instead of writing out of bounds
+		if( f->atlasY + h > TTF_ATLAS_H )
+		{
+			glyph->rc.left = glyph->rc.right = 0;
+			glyph->rc.top = glyph->rc.bottom = 0;
+			glyph->advance = Q_rint( advance * f->scale );
+			glyph->xoff = glyph->yoff = 0;
+			return;
+		}
+	}
+
+	if( h > f->rowH )
+		f->rowH = h;
+
+	if( gw > 0 && gh > 0 )
+	{
+		bitmap = Mem_Malloc( CL_TTFPool(), gw * gh );
+		stbtt_MakeCodepointBitmap( &f->info, bitmap, gw, gh, gw, f->scale, f->scale, codepoint );
+	}
+
+	cov = Mem_Calloc( CL_TTFPool(), w * h );
+
+	if( bitmap )
+	{
+		for( py = 0; py < gh; py++ )
+			memcpy( &cov[( py + TTF_OUTLINE + TTF_ATLAS_BORDER ) * w + TTF_OUTLINE + TTF_ATLAS_BORDER],
+				&bitmap[py * gw], gw );
+
+		// stb_truetype has no hinting, so small glyphs come out soft: steepen the edge ramp
+		// a little so strokes look crisp while keeping the anti-aliasing
+		for( py = 0; py < w * h; py++ )
+			cov[py] = bound( 0, ( cov[py] - 36 ) * 255 / 170, 255 );
+
+		Mem_Free( bitmap );
+	}
+
+	// write RGBA into the atlas: white core, black 1px outline for readability over the game
+	for( py = 0; py < h; py++ )
+	{
+		for( px = 0; px < w; px++ )
+		{
+			int di = ( ( f->atlasY + py ) * TTF_ATLAS_W + f->atlasX + px ) * 4;
+			byte a = cov[py * w + px];
+			byte r = 255, g = 255, b = 255;
+
+			if( a < 128 )
+			{
+				int outline = 0;
+
+				for( int cy = -TTF_OUTLINE; cy <= TTF_OUTLINE && !outline; cy++ )
+				{
+					for( int cx = -TTF_OUTLINE; cx <= TTF_OUTLINE; cx++ )
+					{
+						int nx = px + cx, ny = py + cy;
+
+						if( nx < 0 || ny < 0 || nx >= w || ny >= h )
+							continue;
+
+						if( cov[ny * w + nx] >= 128 )
+						{
+							outline = 1;
+							break;
+						}
+					}
+				}
+
+				if( outline )
+				{
+					a = 255;
+					r = g = b = 0;
+				}
+			}
+
+			f->atlas[di + 0] = r;
+			f->atlas[di + 1] = g;
+			f->atlas[di + 2] = b;
+			f->atlas[di + 3] = a;
+		}
+	}
+
+	glyph->rc.left = f->atlasX;
+	glyph->rc.top = f->atlasY;
+	glyph->rc.right = f->atlasX + w;
+	glyph->rc.bottom = f->atlasY + h;
+	// the baked bitmap carries the outline on both sides: keep it from touching the next glyph
+	glyph->advance = Q_rint( advance * f->scale ) + TTF_OUTLINE * 2;
+	// bitmap position relative to the pen/baseline, minus the baked padding
+	glyph->xoff = x0 - ( TTF_OUTLINE + TTF_ATLAS_BORDER );
+	glyph->yoff = y0 - ( TTF_OUTLINE + TTF_ATLAS_BORDER );
+
+	f->atlasX += w + TTF_ATLAS_BORDER;
+
+	Mem_Free( cov );
+}
+
+static void CL_TTFUploadAtlas( cl_font_t *font, uint texFlags )
+{
+	rgbdata_t pic;
+
+	memset( &pic, 0, sizeof( pic ));
+	pic.width = TTF_ATLAS_W;
+	pic.height = TTF_ATLAS_H;
+	pic.type = PF_RGBA_32;
+	pic.size = TTF_ATLAS_W * TTF_ATLAS_H * 4;
+	pic.flags = IMAGE_HAS_COLOR|IMAGE_HAS_ALPHA;
+	pic.buffer = font->ttf->atlas;
+
+	font->ttf->hAtlasTex = GL_LoadTextureInternal( font->ttf->texname, &pic, texFlags );
+	font->hFontTexture = font->ttf->hAtlasTex;
+}
+
+qboolean Con_LoadTrueTypeFont( const char *fontname, cl_font_t *font, float scale, convar_t *rendermode, uint texFlags, int pixelHeight )
+{
+	fs_offset_t length;
+	cl_ttfont_t *f;
+	size_t i, nsyll;
+
+	if( !rendermode || font->valid )
+		return false;
+
+	nsyll = sizeof( table_ksx1001 ) / sizeof( table_ksx1001[0] );
+
+	byte *pfile = g_fsapi.LoadFile( fontname, &length, false );
+	if( !pfile )
+		return false;
+
+	f = Mem_Calloc( CL_TTFPool(), sizeof( *f ));
+	f->file = pfile;
+
+	if( !stbtt_InitFont( &f->info, pfile, stbtt_GetFontOffsetForIndex( pfile, 0 )))
+	{
+		Mem_Free( f->file );
+		Mem_Free( f );
+		return false;
+	}
+
+	f->scale = stbtt_ScaleForPixelHeight( &f->info, pixelHeight );
+	f->pixelHeight = pixelHeight;
+	{
+		int ascentRaw = 0;
+		stbtt_GetFontVMetrics( &f->info, &ascentRaw, NULL, NULL );
+		f->ascent = Q_rint( ascentRaw * f->scale );
+	}
+	f->atlas = Mem_Calloc( CL_TTFPool(), TTF_ATLAS_W * TTF_ATLAS_H * 4 );
+	// unique per instance: the HUD font and each console font size bake their own
+	// atlas and the renderer caches textures by name, a shared name would make the
+	// second font draw from the first font's atlas (garbled overlapping glyphs)
+	Q_snprintf( f->texname, sizeof( f->texname ), "*ttf_%p_%i", (void *)f, pixelHeight );
+
+	font->ttf = f; // bake functions read it through font
+
+	for( i = 0; i < nsyll; i++ )
+		f->ksxMap[table_ksx1001[i] - 0xAC00] = i + 1;
+
+	for( i = 0x20; i < 0x7f; i++ )
+		CL_TTFBakeGlyph( font, i, &f->ascii[i] );
+
+	for( i = 0; i < nsyll; i++ )
+		CL_TTFBakeGlyph( font, table_ksx1001[i], &f->hangul[i] );
+
+	CL_TTFUploadAtlas( font, texFlags );
+
+	// the renderer keeps its own copy of the atlas, don't hold 8MB of CPU memory per font
+	Mem_Free( f->atlas );
+	f->atlas = NULL;
+
+	font->type = FONT_TRUETYPE;
+	font->valid = true;
+	font->scale = scale ? scale : 1.0f;
+	font->rendermode = rendermode;
+	// include the outline/border padding so lines don't overlap vertically
+	font->charHeight = pixelHeight + ( TTF_OUTLINE + TTF_ATLAS_BORDER ) * 2;
+
+	for( i = 0; i < 256; i++ )
+	{
+		ttf_glyph_t *g = ( i < 128 ) ? &f->ascii[i] : &f->ascii['?'];
+
+		font->charWidths[i] = bound( 0, g->advance, 255 );
+	}
+
+	Con_Reportf( "LoadTrueTypeFont( %s, %ipx ): %zu Hangul + ASCII baked\n", fontname, pixelHeight, nsyll );
+
+	return true;
+}
+
+static int CL_DrawCharacterTTF( float x, float y, int number, const rgba_t color, cl_font_t *font, int flags )
+{
+	cl_ttfont_t *f = font->ttf;
+	ttf_glyph_t *glyph = CL_TTFLookup( f, number );
+	int texw, texh;
+	float s1, t1, s2, t2, w, h;
+
+	R_GetTextureParms( &texw, &texh, f->hAtlasTex );
+	if( !texw || !texh )
+		return glyph->advance * font->scale;
+
+	s1 = (float)glyph->rc.left / texw;
+	t1 = (float)glyph->rc.top / texh;
+	s2 = (float)glyph->rc.right / texw;
+	t2 = (float)glyph->rc.bottom / texh;
+	w = ( glyph->rc.right - glyph->rc.left ) * font->scale;
+	h = ( glyph->rc.bottom - glyph->rc.top ) * font->scale;
+
+	// place the glyph box on the baseline instead of aligning every box top
+	// to the line top, otherwise letters ride at different heights
+	x += glyph->xoff * font->scale;
+	y += ( f->ascent + glyph->yoff ) * font->scale;
+
+	if( FBitSet( flags, FONT_DRAW_HUD ))
+		SPR_AdjustSize( &x, &y, &w, &h );
+
+	// a glyph that lands between pixels gets bilinear-filtered into a blur
+	x = Q_rint( x );
+	y = Q_rint( y );
+	w = Q_rint( w );
+	h = Q_rint( h );
+
+	if( !FBitSet( flags, FONT_DRAW_NORENDERMODE ))
+		CL_SetFontRendermode( font );
+
+	if( !FBitSet( flags, FONT_DRAW_NOCOLOR ))
+		CL_SetFontColor( font, color );
+
+	ref.dllFuncs.R_DrawStretchPic( x, y, w, h, s1, t1, s2, t2, f->hAtlasTex );
+
+	return glyph->advance * font->scale;
+}
+
