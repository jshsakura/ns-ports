 }
+
+// The SDL Switch backend reports no gyroscope for the built-in controller of the Lite
+// ("gyro no" in engine.log), so read the sensor through libnx and feed the engine's
+// gamepad gyro path ourselves. SDL still wins whenever it does report one.
+//
+// Axis mapping and scale can be tuned from a cfg without rebuilding:
+//   joy_nx_gyro_pitch / joy_nx_gyro_yaw / joy_nx_gyro_roll  "x", "y" or "z", a leading "-" inverts
+//   joy_nx_gyro_scale  sensor units to rad/s (default one revolution per second)
+static struct
+{
+	qboolean tried, ok, claimed;
+	HidSixAxisSensorHandle handheld, fullkey, dual[2];
+	convar_t *pitch, *yaw, *roll, *scale;
+} nxgyro;
+
+static float NSwitch_GyroAxis( const HidVector *v, const char *spec )
+{
+	float sign = 1.0f;
+
+	if( *spec == '-' )
+	{
+		sign = -1.0f;
+		spec++;
+	}
+
+	switch( *spec )
+	{
+	case 'x': return sign * v->x;
+	case 'y': return sign * v->y;
+	case 'z': return sign * v->z;
+	}
+
+	return 0.0f;
+}
+
+static void NSwitch_GyroInit( void )
+{
+	nxgyro.tried = true;
+
+	nxgyro.pitch = Cvar_Get( "joy_nx_gyro_pitch", "x", 0, "Switch built-in gyro axis used for looking up and down (x, y, z, optional leading -)" );
+	nxgyro.yaw = Cvar_Get( "joy_nx_gyro_yaw", "y", 0, "Switch built-in gyro axis used for turning left and right (x, y, z, optional leading -)" );
+	nxgyro.roll = Cvar_Get( "joy_nx_gyro_roll", "z", 0, "Switch built-in gyro axis used for rolling (x, y, z, optional leading -)" );
+	nxgyro.scale = Cvar_Get( "joy_nx_gyro_scale", "6.2831853", 0, "Switch gyro sensor units to rad/s" );
+
+	if( R_FAILED( hidGetSixAxisSensorHandles( &nxgyro.handheld, 1, HidNpadIdType_Handheld, HidNpadStyleTag_NpadHandheld )))
+		return;
+
+	hidGetSixAxisSensorHandles( &nxgyro.fullkey, 1, HidNpadIdType_No1, HidNpadStyleTag_NpadFullKey );
+	hidGetSixAxisSensorHandles( nxgyro.dual, 2, HidNpadIdType_No1, HidNpadStyleTag_NpadJoyDual );
+
+	hidStartSixAxisSensor( nxgyro.handheld );
+	hidStartSixAxisSensor( nxgyro.fullkey );
+	hidStartSixAxisSensor( nxgyro.dual[0] );
+	hidStartSixAxisSensor( nxgyro.dual[1] );
+
+	nxgyro.ok = true;
+	Con_Printf( "Switch gyroscope: reading through libnx\n" );
+}
+
+void NSwitch_PollGyro( void )
+{
+	HidSixAxisSensorHandle handle;
+	HidSixAxisSensorState state;
+	vec3_t data;
+	float scale;
+
+	if( !nxgyro.tried )
+		NSwitch_GyroInit();
+
+	if( !nxgyro.ok )
+		return;
+
+	// SDL found a sensor on its own, leave it to SDL
+	if( !nxgyro.claimed && Cvar_VariableValue( "joy_have_gyro" ) != 0.0f )
+		return;
+
+	if( hidGetNpadStyleSet( HidNpadIdType_Handheld ) & HidNpadStyleTag_NpadHandheld )
+		handle = nxgyro.handheld;
+	else
+	{
+		u32 style = hidGetNpadStyleSet( HidNpadIdType_No1 );
+
+		if( style & HidNpadStyleTag_NpadJoyDual )
+			handle = nxgyro.dual[1]; // right Joy-Con
+		else if( style & HidNpadStyleTag_NpadFullKey )
+			handle = nxgyro.fullkey;
+		else
+			return;
+	}
+
+	// the engine resets these whenever the active gamepad changes
+	if( Cvar_VariableValue( "joy_have_gyro" ) == 0.0f )
+		Joy_SetCapabilities( true, 0 );
+	Joy_SetCalibrationState( JOY_CALIBRATED );
+	nxgyro.claimed = true;
+
+	if( hidGetSixAxisSensorStates( handle, &state, 1 ) < 1 )
+		return;
+
+	scale = nxgyro.scale->value;
+	data[0] = NSwitch_GyroAxis( &state.angular_velocity, nxgyro.pitch->string ) * scale;
+	data[1] = NSwitch_GyroAxis( &state.angular_velocity, nxgyro.yaw->string ) * scale;
+	data[2] = NSwitch_GyroAxis( &state.angular_velocity, nxgyro.roll->string ) * scale;
+
+	Joy_GyroEvent( data );
+}
