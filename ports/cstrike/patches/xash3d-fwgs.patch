diff --git a/engine/platform/sdl2/s_sdl2.c b/engine/platform/sdl2/s_sdl2.c
index d216f6c..94a10b5 100644
--- a/engine/platform/sdl2/s_sdl2.c
+++ b/engine/platform/sdl2/s_sdl2.c
@@ -242,6 +242,202 @@ void SNDDMA_Activate( qboolean active )
 	SDL_PauseAudioDevice( sdl_dev, !active );
 }
 
+#if XASH_NSWITCH
+/*
+===========
+Switch microphone
+
+SDL has no capture driver on the Switch, so the headset microphone is read
+through libnx audin on a thread that only works while the voice key is held.
+===========
+*/
+#include <switch.h>
+#include <pthread.h>
+
+#define NX_AUDIN_BUFFERS 4
+#define NX_AUDIN_ALIGN   0x1000
+
+static pthread_t nx_thread;
+static pthread_mutex_t nx_lock = PTHREAD_MUTEX_INITIALIZER;
+static AudioInBuffer nx_buffers[NX_AUDIN_BUFFERS];
+static void *nx_memory[NX_AUDIN_BUFFERS];
+static volatile qboolean nx_open, nx_run, nx_active, nx_started;
+static double nx_phase;
+
+static void NX_PushSamples( const int16_t *in, int frames, int channels, int rate )
+{
+	const double step = (double)rate / voice.samplerate;
+
+	pthread_mutex_lock( &nx_lock );
+
+	while( nx_phase < frames - 1 )
+	{
+		int i = (int)nx_phase;
+		double frac = nx_phase - i;
+		int a = channels == 2 ? ( in[i * 2] + in[i * 2 + 1] ) / 2 : in[i];
+		int b = channels == 2 ? ( in[i * 2 + 2] + in[i * 2 + 3] ) / 2 : in[i + 1];
+		int16_t out = (int16_t)( a + ( b - a ) * frac );
+
+		if( voice.input_buffer_pos + (int)sizeof( out ) > (int)sizeof( voice.input_buffer ))
+			break; // engine can't keep up, skip audio
+
+		memcpy( voice.input_buffer + voice.input_buffer_pos, &out, sizeof( out ));
+		voice.input_buffer_pos += sizeof( out );
+		nx_phase += step;
+	}
+
+	nx_phase -= frames;
+	if( nx_phase < 0.0 ) nx_phase = 0.0;
+
+	pthread_mutex_unlock( &nx_lock );
+}
+
+static void *NX_CaptureThread( void *unused )
+{
+	const int rate = (int)audinGetSampleRate();
+	const int channels = (int)audinGetChannelCount();
+
+	while( nx_run )
+	{
+		AudioInBuffer *released = NULL;
+		u32 count = 0;
+
+		if( !nx_active )
+		{
+			svcSleepThread( 10000000ULL );
+			continue;
+		}
+
+		if( R_FAILED( audinWaitCaptureFinish( &released, &count, 50000000ULL )) || !count )
+			continue;
+
+		for( u32 i = 0; i < count; i++ )
+		{
+			AudioInBuffer *buf = &released[i];
+
+			if( buf->data_size > 0 && channels > 0 )
+				NX_PushSamples( (const int16_t *)buf->buffer, (int)( buf->data_size / ( sizeof( int16_t ) * channels )), channels, rate );
+
+			buf->data_size = 0;
+			audinAppendAudioInBuffer( buf );
+		}
+	}
+
+	return NULL;
+}
+
+qboolean VoiceCapture_Init( void )
+{
+	int i;
+
+	if( nx_open )
+		VoiceCapture_Shutdown();
+
+	if( R_FAILED( audinInitialize( )))
+	{
+		Con_Printf( S_ERROR "%s: audin is not available\n", __func__ );
+		return false;
+	}
+
+	for( i = 0; i < NX_AUDIN_BUFFERS; i++ )
+	{
+		const u32 size = 0x4000;
+
+		nx_memory[i] = aligned_alloc( NX_AUDIN_ALIGN, size );
+		if( !nx_memory[i] )
+			break;
+
+		memset( &nx_buffers[i], 0, sizeof( nx_buffers[i] ));
+		nx_buffers[i].buffer = nx_memory[i];
+		nx_buffers[i].buffer_size = size;
+	}
+
+	if( i != NX_AUDIN_BUFFERS )
+	{
+		while( i-- > 0 ) free( nx_memory[i] );
+		audinExit();
+		return false;
+	}
+
+	nx_run = true;
+	nx_active = false;
+	nx_started = false;
+	nx_phase = 0.0;
+
+	if( pthread_create( &nx_thread, NULL, NX_CaptureThread, NULL ))
+	{
+		nx_run = false;
+		for( i = 0; i < NX_AUDIN_BUFFERS; i++ ) free( nx_memory[i] );
+		audinExit();
+		return false;
+	}
+
+	nx_open = true;
+	Con_Printf( S_NOTE "%s: Switch microphone ready (%u Hz, %u ch)\n", __func__, audinGetSampleRate(), audinGetChannelCount() );
+	return true;
+}
+
+qboolean VoiceCapture_Activate( qboolean activate )
+{
+	int i;
+
+	if( !nx_open )
+		return false;
+
+	if( activate && !nx_started )
+	{
+		if( R_FAILED( audinStartAudioIn( )))
+			return false;
+
+		for( i = 0; i < NX_AUDIN_BUFFERS; i++ )
+		{
+			nx_buffers[i].data_size = 0;
+			audinAppendAudioInBuffer( &nx_buffers[i] );
+		}
+
+		nx_phase = 0.0;
+		nx_started = true;
+	}
+	else if( !activate && nx_started )
+	{
+		nx_active = false;
+		audinStopAudioIn();
+		nx_started = false;
+	}
+
+	nx_active = activate;
+	return true;
+}
+
+qboolean VoiceCapture_Lock( qboolean lock )
+{
+	if( !nx_open )
+		return false;
+
+	if( lock ) pthread_mutex_lock( &nx_lock );
+	else pthread_mutex_unlock( &nx_lock );
+
+	return true;
+}
+
+void VoiceCapture_Shutdown( void )
+{
+	int i;
+
+	if( !nx_open )
+		return;
+
+	VoiceCapture_Activate( false );
+	nx_run = false;
+	pthread_join( nx_thread, NULL );
+
+	for( i = 0; i < NX_AUDIN_BUFFERS; i++ )
+		free( nx_memory[i] );
+
+	audinExit();
+	nx_open = false;
+}
+#else
 /*
 ===========
 SDL_SoundInputCallback
@@ -335,3 +531,4 @@ void VoiceCapture_Shutdown( void )
 	SDL_CloseAudioDevice( in_dev );
 	in_dev = 0;
 }
+#endif // XASH_NSWITCH
