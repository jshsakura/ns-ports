# devkitA64 + libnx 용 CMake 툴체인. 엔진의 NintendoSwitch 클래스(xcompile.py)와 같은 플래그를 쓴다.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(DKP $ENV{DEVKITPRO})
set(CMAKE_C_COMPILER   ${DKP}/devkitA64/bin/aarch64-none-elf-gcc)
set(CMAKE_CXX_COMPILER ${DKP}/devkitA64/bin/aarch64-none-elf-g++)
set(CMAKE_AR           ${DKP}/devkitA64/bin/aarch64-none-elf-gcc-ar)
set(CMAKE_RANLIB       ${DKP}/devkitA64/bin/aarch64-none-elf-gcc-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARCH "-D__SWITCH__ -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIC -ffunction-sections -fdata-sections -isystem /work/scripts/shim -isystem /work/libsolder/include -isystem ${DKP}/libnx/include -isystem ${DKP}/portlibs/switch/include -D_GNU_SOURCE -include dlfcn.h")
set(CMAKE_C_FLAGS_INIT   "${ARCH}")
set(CMAKE_CXX_FLAGS_INIT "${ARCH}")
# 게임 .so: 표준 라이브러리 없이, 미해결 심볼은 NRO 에서 가져온다 (libsolder)
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-specs=${DKP}/libnx/switch.specs -Wl,--hash-style=sysv -rdynamic -nostdlib -nostartfiles -Wl,--unresolved-symbols=ignore-all")
set(CMAKE_FIND_ROOT_PATH ${DKP}/portlibs/switch ${DKP}/libnx)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# 프로젝트들이 -Wl,--no-undefined 를 직접 붙인다. 게임 .so 는 NRO 에서 심볼을 받으므로 링크 줄 맨 끝에서 되돌린다.
set(CMAKE_CXX_CREATE_SHARED_LIBRARY "<CMAKE_CXX_COMPILER> <CMAKE_SHARED_LIBRARY_CXX_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <CMAKE_SHARED_LIBRARY_CREATE_CXX_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES> /work/build-stubs.o -Wl,-z,undefs")
set(CMAKE_C_CREATE_SHARED_LIBRARY "<CMAKE_C_COMPILER> <CMAKE_SHARED_LIBRARY_C_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <CMAKE_SHARED_LIBRARY_CREATE_C_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES> /work/build-stubs.o -Wl,-z,undefs")
